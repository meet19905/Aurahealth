generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("PATIENT") // ADMIN, DOCTOR, PATIENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorProfile DoctorProfile?
  appointments  Appointment[]  @relation("PatientAppointments")
}

model DoctorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  specialization String
  workingHours   String?  // JSON string
  slotDuration   Int      @default(30) // in minutes
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointments Appointment[] @relation("DoctorAppointments")
  leaves       Leave[]
}

model Leave {
  id        String        @id @default(uuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id])
  date      DateTime
  reason    String?
  status    String        @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime      @default(now())

  @@unique([doctorId, date])
}

model DoctorRegistrationRequest {
  id             String   @id @default(uuid())
  name           String
  email          String   @unique
  password       String
  specialization String
  status         String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt      DateTime @default(now())
}

model Appointment {
  id                   String            @id @default(uuid())
  patientId            String
  patient              User              @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId             String
  doctor               DoctorProfile     @relation("DoctorAppointments", fields: [doctorId], references: [id])
  date                 DateTime
  startTime            String            // e.g. "09:00"
  endTime              String            // e.g. "09:30"
  status               String            @default("PENDING")
  holdExpiresAt        DateTime?         // For slot hold mechanism

  // Pre-visit
  symptoms             String?
  aiPreVisitSummary    String?           // JSON string from LLM

  // Post-visit
  doctorNotes          String?
  prescription         String?
  aiPostVisitSummary   String?           // JSON string from LLM

  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

model NotificationOutbox {
  id          String             @id @default(uuid())
  type        String
  payload     String             // JSON string
  status      String             @default("PENDING")
  retries     Int                @default(0)
  nextRetryAt DateTime           @default(now())
  error       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}
